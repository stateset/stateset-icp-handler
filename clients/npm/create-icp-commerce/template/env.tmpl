# Scaffolded by @stateset/create-icp-commerce. Safe defaults for local
# development; review before running in production.

# --- bind ------------------------------------------------------------
HOST=0.0.0.0
PORT=8082
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# --- protocol --------------------------------------------------------
ICP_REQUIRE_MANDATE=true
# Dev-only: accept `alg:none` mandates to skip Ed25519 signing during
# smoke tests. Flip to `true` (or delete) before going to prod.
ICP_VERIFY_MANDATE_SIGNATURES=false

# --- tenant keys -----------------------------------------------------
# Demo bearer keys `icp_demo_key_*` wired into the handler for local
# use. Replace with `ICP_API_KEYS_JSON=[...]` before exposing publicly.
ICP_ENABLE_DEMO_KEYS=true

# --- state + engine --------------------------------------------------
ICP_STATE_DB_PATH=./icp-state.db
COMMERCE_ENABLED=true
COMMERCE_DB_PATH=./commerce.db

# --- interop ---------------------------------------------------------
ICP_ACP_COMPAT_ENABLED=true
ICP_UCP_COMPAT_ENABLED=true
ICP_MCP_ENABLED=true
ICP_A2A_ENABLED=true

# --- observability ---------------------------------------------------
LOG_LEVEL=info

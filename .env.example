# --- bind ------------------------------------------------------------
HOST=0.0.0.0
PORT=8082
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# --- protocol --------------------------------------------------------
ICP_VERSION=2026-04-21
ICP_REQUIRE_VERSION=true
ICP_REQUIRE_MANDATE=true
ICP_REQUIRE_REQUEST_ID=true
ICP_REQUIRE_IDEMPOTENCY_KEY=true
# Cryptographically verify mandate JWS signatures against the principal's
# resolved keyset. Production default is true; flip to false ONLY for
# local development against `alg:none` test fixtures.
ICP_VERIFY_MANDATE_SIGNATURES=true

# --- identity + signing ---------------------------------------------
ICP_PUBLIC_BASE_URL=http://127.0.0.1:8082
ICP_HANDLER_ID=icp://localhost
ICP_SERVICE_NAME=StateSet ICP Handler
ICP_SIGNING_KID=icp-receipt-2026-04
# Required for production. PKCS#8 Ed25519 private key PEM.
# ICP_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----..."
ICP_ALLOW_INSECURE_URLS=true

# --- CORS ------------------------------------------------------------
ICP_CORS_ALLOW_ORIGINS=*

# --- tenant API keys -------------------------------------------------
# Either supply a JSON array inline, a file path, or enable demo keys.
# ICP_API_KEYS_JSON=[{"key":"prod_key_1","tenant_id":"merchant_1","name":"Primary","rate_limit_per_minute":300}]
# ICP_API_KEYS_FILE=/etc/icp/api_keys.json
ICP_ENABLE_DEMO_KEYS=false

# --- commerce engine (stateset-icommerce) ---------------------------
COMMERCE_ENABLED=true
COMMERCE_DB_PATH=./commerce.db
# To use PostgreSQL, build with `--features postgres` and set:
# COMMERCE_DB_PATH=postgres://icp:icp@db:5432/commerce

# --- state -----------------------------------------------------------
ICP_TRANSACTION_TTL_SECONDS=21600
# SQLite path for handler-owned state (mandate spend, receipts,
# transactions, subscriptions, peer quotes). Separate from
# COMMERCE_DB_PATH because protocol state evolves independently of the
# commerce engine schema. Use :memory: for ephemeral runs.
ICP_STATE_DB_PATH=./icp-state.db
# Reserved for a future distributed ledger; read but not wired in v0.1.
# REDIS_URL=redis://127.0.0.1:6379

# --- outbound webhooks ----------------------------------------------
# ICP_WEBHOOK_URL=https://platform.example/icp/events
# ICP_WEBHOOK_SECRET=change-me

# --- production safety ----------------------------------------------
# Set to `production` to fail fast unless durable state, HTTPS URLs,
# scoped CORS, signed mandates, idempotency, non-demo keys, persistent
# receipt signing key, and external payment authorization are configured.
ICP_DEPLOYMENT_ENV=development
# `simulated` is for local/dev. `external_required` only accepts
# payment.method=external_authorization for captures.
ICP_PAYMENT_EXECUTION_MODE=simulated

# --- interop toggles -------------------------------------------------
ICP_A2A_ENABLED=true
ICP_MCP_ENABLED=true
ICP_ACP_COMPAT_ENABLED=true
ICP_UCP_COMPAT_ENABLED=true

# --- rate limiting --------------------------------------------------
ICP_RATE_LIMIT_PER_MINUTE=300
ICP_PRE_AUTH_RATE_LIMIT_PER_MINUTE=120

# --- observability --------------------------------------------------
LOG_LEVEL=info
